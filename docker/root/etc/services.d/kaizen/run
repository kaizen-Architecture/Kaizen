#!/usr/bin/with-contenv bash

cd /app

shopt -s globstar

umask 022

CORE_BIN="kaizen-mangal"
if [ -x /config/bin/kaizen-mangal ]; then
  CORE_BIN="/config/bin/kaizen-mangal"
fi

"$CORE_BIN" config set -k metadata.comic_info_xml --value true
"$CORE_BIN" config set -k metadata.fetch_anilist --value true
"$CORE_BIN" config set -k metadata.series_json --value true
"$CORE_BIN" config set -k formats.use --value "cbz"
"$CORE_BIN" config set -k downloader.download_cover --value true
"$CORE_BIN" config set -k downloader.redownload_existing --value true
"$CORE_BIN" config set -k downloader.chapter_name_template --value "[{padded-index}] {chapter}"
"$CORE_BIN" config set -k downloader.create_manga_dir --value true
"$CORE_BIN" config set -k downloader.create_volume_dir --value false
"$CORE_BIN" config set -k downloader.stop_on_error --value true
"$CORE_BIN" config set -k downloader.path --value '.'
"$CORE_BIN" config write 2>/dev/null || true

exec 2>&1
exec s6-setuidgid abc /usr/bin/node dist/server/index.js
